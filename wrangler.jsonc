{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "taxzero",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "triggers": { "crons": ["*/5 * * * *"] },
  // Datos públicos del proyecto de Supabase (la llave publicable no es secreta).
  "vars": {
    "SUPABASE_URL": "https://drarvuaebvznajijvtyl.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_55ecwVhKhmqQ8aXyyS2WlQ_hjtf1d1S"
  },
  // Versiones de prueba que Cloudflare publica para cada PR (usan el mismo proyecto de pruebas).
  "previews": {
    "vars": {
      "SUPABASE_URL": "https://drarvuaebvznajijvtyl.supabase.co",
      "SUPABASE_ANON_KEY": "sb_publishable_55ecwVhKhmqQ8aXyyS2WlQ_hjtf1d1S"
    }
  }
}
