{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "taxzero",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  // Única dirección de la app (opsmyk.com está en esta misma cuenta de Cloudflare).
  // Las direcciones *.workers.dev quedan apagadas, incluidas las de cada versión.
  "routes": [{ "pattern": "taxzero.opsmyk.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "triggers": { "crons": ["*/5 * * * *"] },
  // Documentos (fotos y archivos del evento). Bucket privado con candado contra borrado.
  "r2_buckets": [{ "binding": "DOCS", "bucket_name": "taxzero-documentos" }],
  // Datos públicos del proyecto de Supabase (la llave publicable no es secreta).
  "vars": {
    "SUPABASE_URL": "https://drarvuaebvznajijvtyl.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_55ecwVhKhmqQ8aXyyS2WlQ_hjtf1d1S"
  },
  // Versiones de prueba que Cloudflare publica para cada PR (usan el mismo proyecto de pruebas).
  "previews": {
    "r2_buckets": [{ "binding": "DOCS", "bucket_name": "taxzero-documentos" }],
    "vars": {
      "SUPABASE_URL": "https://drarvuaebvznajijvtyl.supabase.co",
      "SUPABASE_ANON_KEY": "sb_publishable_55ecwVhKhmqQ8aXyyS2WlQ_hjtf1d1S"
    }
  }
}
